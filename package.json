{
  "name": "@jack_rogers/mapbox-bbox-grid",
  "description": "Generate GeoJSON grids or on-demand vector tiles for Mapbox GL JS maps.",
  "keywords": [
    "mapbox",
    "mapbox-gl",
    "geojson",
    "grid",
    "fishnet",
    "bounding-box",
    "gis",
    "typescript"
  ],
  "license": "MIT",
  "author": "Jack Rogers",
  "homepage": "https://github.com/Jack-Rogers2003/mapbox-bbox-grid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jack-Rogers2003/mapbox-bbox-grid.git"
  },
  "bugs": {
    "url": "https://github.com/Jack-Rogers2003/mapbox-bbox-grid/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/copy-cjs-types.mjs",
    "typecheck": "tsc -p .",
    "lint": "biome check src tests scripts tsup.config.ts",
    "lint:fix": "biome check --write src tests scripts tsup.config.ts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "peerDependencies": {
    "mapbox-gl": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "proj4": "^2.22.0"
  }
}
